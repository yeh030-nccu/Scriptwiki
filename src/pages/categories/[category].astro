---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { categories } from '../../data/categories.js';
import { pathTo } from '../../lib/site.js';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return categories.map((category) => ({
    params: { category: category.slug },
    props: {
      category,
      articles: articles
        .filter((article) => article.data.category === category.slug)
        .sort((a, b) => a.data.order - b.data.order),
    },
  }));
}

const { category, articles } = Astro.props;
const categoryIndex = String(categories.findIndex((item) => item.slug === category.slug) + 1).padStart(2, '0');
---
<SiteLayout title={category.title} currentCategory={category.slug}>
  <nav class="breadcrumbs" aria-label="麵包屑導覽">
    <a href={pathTo('')}>首頁</a><span class="breadcrumb-separator" aria-hidden="true">/</span>
    <span aria-current="page">{category.title}</span>
  </nav>

  <header class="category-banner">
    <div>
      <span class="category-banner-label">目前分類 / CATEGORY {categoryIndex}</span>
      <h1>{category.title}</h1>
      <p>{category.description}</p>
    </div>
    <span class="category-banner-count">{articles.length} 篇方法</span>
  </header>

  <section class="listing" aria-label={`${category.title}文章列表`}>
    <div class="article-list">
      {articles.map((article, index) => (
        <div class="article-row">
          <span class="article-order">{String(index + 1).padStart(2, '0')}</span>
          <div class="article-row-main">
            <a class="article-row-title" href={pathTo(`articles/${article.data.slug}/`)}>{article.data.title}</a>
            <p>{article.data.summary}</p>
          </div>
          <a class="read-link" href={pathTo(`articles/${article.data.slug}/`)} aria-label={`閱讀：${article.data.title}`}>閱讀文章 →</a>
        </div>
      ))}
    </div>
  </section>

  <p class="category-endnote">分類提供快速索引；同一套方法也可能從不同角度閱讀，實際分析仍以作品的脈絡與證據為準。</p>
</SiteLayout>
